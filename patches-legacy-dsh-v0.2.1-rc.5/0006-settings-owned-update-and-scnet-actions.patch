diff --git a/packages/client/ui-settings-general/src/client/ScnetSettingsRow.tsx b/packages/client/ui-settings-general/src/client/ScnetSettingsRow.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..071a7080cafa64410f3a15dd4144a62094860fc0
--- /dev/null
+++ b/packages/client/ui-settings-general/src/client/ScnetSettingsRow.tsx
@@ -0,0 +1,61 @@
+/** Settings-owned SCNet configuration action with redacted local status. */
+import { useEffect, useState } from 'react'
+import { Button } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import type { ScnetBridge, ScnetStatusSnapshot } from '../types.ts'
+import css from './ScnetSettingsRow.module.css'
+
+type Props = PropsRuntime<'settings.general.item'> & PropsLocale<'settings'>
+
+function bridgeFromWindow(): ScnetBridge | undefined {
+  const carrier = (globalThis as typeof globalThis & {
+    dshDesktop?: { protocolVersion: number; scnet?: ScnetBridge }
+  }).dshDesktop
+  return carrier?.protocolVersion === 1 ? carrier.scnet : undefined
+}
+
+export function ScnetSettingsRow({ t }: Props) {
+  const bridge = bridgeFromWindow()
+  const [snapshot, setSnapshot] = useState<ScnetStatusSnapshot | undefined>()
+  const [busy, setBusy] = useState(false)
+  const [failed, setFailed] = useState(false)
+
+  useEffect(() => {
+    if (bridge === undefined) return
+    let live = true
+    void bridge.status().then(value => {
+      if (live) setSnapshot(value)
+    }, () => {
+      if (live) setFailed(true)
+    })
+    return () => { live = false }
+  }, [bridge])
+
+  if (bridge === undefined) return null
+  const overall = snapshot?.diagnostics.overall
+  const status = overall === 'ready'
+    ? t('scnet.ready')
+    : overall === 'needs-setup'
+      ? t('scnet.needsSetup')
+      : overall === 'disabled'
+        ? t('scnet.disabled')
+        : overall === 'unavailable'
+          ? t('scnet.unavailable')
+          : t('scnet.checking')
+  return <div className={css.row}>
+    <div className={css.copy}>
+      <div className={css.title}>{t('scnet.title')}</div>
+      <div className={css.description}>
+        {failed ? t('scnet.error') : `${t('scnet.description')} · ${status}`}
+      </div>
+    </div>
+    <Button variant="outline" size="sm" disabled={busy}
+      onClick={() => {
+        setFailed(false)
+        setBusy(true)
+        void bridge.setup().then(() => bridge.status().then(setSnapshot)).catch(() => { setFailed(true) }).finally(() => { setBusy(false) })
+      }}>
+      {busy ? t('scnet.opening') : t('scnet.configure')}
+    </Button>
+  </div>
+}
