diff --git a/apps/desktop/src/scnet-auth-callback.ts b/apps/desktop/src/scnet-auth-callback.ts
new file mode 100644
index 0000000..76dc212
--- /dev/null
+++ b/apps/desktop/src/scnet-auth-callback.ts
@@ -0,0 +1,155 @@
+const SCNET_AUTH_SCHEME = 'dsh:'
+const SCNET_AUTH_HOST = 'auth'
+const SCNET_AUTH_PATH = '/scnet'
+const MAX_STATE_LENGTH = 512
+const MAX_CODE_LENGTH = 4096
+const MAX_ERROR_LENGTH = 128
+const MAX_DESCRIPTION_LENGTH = 1024
+const MAX_URI_LENGTH = 2048
+
+const ALLOWED_PARAMETERS = new Set(['code', 'error', 'error_description', 'error_uri', 'iss', 'state'])
+
+export type ScnetAuthCallback =
+  | {
+    readonly kind: 'success'
+    readonly code: string
+    readonly state: string
+    readonly issuer?: string
+  }
+  | {
+    readonly kind: 'error'
+    readonly error: string
+    readonly state: string
+    readonly description?: string
+    readonly errorUri?: string
+    readonly issuer?: string
+  }
+
+export type ScnetAuthCallbackParseErrorCode =
+  | 'invalid-url'
+  | 'invalid-target'
+  | 'invalid-parameters'
+  | 'missing-state'
+  | 'invalid-result'
+
+export class ScnetAuthCallbackParseError extends Error {
+  readonly code: ScnetAuthCallbackParseErrorCode
+
+  constructor(code: ScnetAuthCallbackParseErrorCode) {
+    super(`SCNet auth callback rejected (${code})`)
+    this.name = 'ScnetAuthCallbackParseError'
+    this.code = code
+  }
+}
+
+function parameterValue(parameters: URLSearchParams, name: string, maxLength: number): string | undefined {
+  const values = parameters.getAll(name)
+  if (values.length > 1) throw new ScnetAuthCallbackParseError('invalid-parameters')
+  const value = values[0]
+  if (value === undefined) return undefined
+  if (value.length === 0 || value.length > maxLength || /[\u0000-\u001f\u007f]/u.test(value)) {
+    throw new ScnetAuthCallbackParseError('invalid-parameters')
+  }
+  return value
+}
+
+function optionalParameter(parameters: URLSearchParams, name: string, maxLength: number): string | undefined {
+  return parameterValue(parameters, name, maxLength)
+}
+
+/**
+ * Parse only the local OAuth callback shape. This function does not validate an issuer,
+ * exchange a code, or contact a network endpoint.
+ */
+export function parseScnetAuthCallbackUrl(rawUrl: string): ScnetAuthCallback {
+  let url: URL
+  try {
+    url = new URL(rawUrl)
+  } catch {
+    throw new ScnetAuthCallbackParseError('invalid-url')
+  }
+  if (url.protocol !== SCNET_AUTH_SCHEME || url.hostname !== SCNET_AUTH_HOST
+    || url.pathname !== SCNET_AUTH_PATH || url.port !== '' || url.username !== '' || url.password !== ''
+    || url.hash !== '') {
+    throw new ScnetAuthCallbackParseError('invalid-target')
+  }
+  for (const key of url.searchParams.keys()) {
+    if (!ALLOWED_PARAMETERS.has(key)) throw new ScnetAuthCallbackParseError('invalid-parameters')
+  }
+  const state = parameterValue(url.searchParams, 'state', MAX_STATE_LENGTH)
+  if (state === undefined) throw new ScnetAuthCallbackParseError('missing-state')
+  const code = optionalParameter(url.searchParams, 'code', MAX_CODE_LENGTH)
+  const error = optionalParameter(url.searchParams, 'error', MAX_ERROR_LENGTH)
+  const description = optionalParameter(url.searchParams, 'error_description', MAX_DESCRIPTION_LENGTH)
+  const errorUri = optionalParameter(url.searchParams, 'error_uri', MAX_URI_LENGTH)
+  const issuer = optionalParameter(url.searchParams, 'iss', MAX_URI_LENGTH)
+  if ((code === undefined) === (error === undefined)) {
+    throw new ScnetAuthCallbackParseError('invalid-result')
+  }
+  if (code !== undefined) {
+    if (description !== undefined || errorUri !== undefined) throw new ScnetAuthCallbackParseError('invalid-result')
+    return issuer === undefined ? { kind: 'success', code, state } : { kind: 'success', code, state, issuer }
+  }
+  if (error === undefined) throw new ScnetAuthCallbackParseError('invalid-result')
+  return {
+    kind: 'error',
+    error,
+    state,
+    ...(description === undefined ? {} : { description }),
+    ...(errorUri === undefined ? {} : { errorUri }),
+    ...(issuer === undefined ? {} : { issuer }),
+  }
+}
+
+export type ScnetAuthCallbackRoute =
+  | { readonly status: 'ignored' }
+  | { readonly status: 'rejected'; readonly code: ScnetAuthCallbackParseErrorCode }
+  | { readonly status: 'unknown-state' }
+  | { readonly status: 'replayed' }
+  | { readonly status: 'accepted'; readonly callback: ScnetAuthCallback }
+
+export interface ScnetAuthCallbackRouter {
+  register(state: string, handler: (callback: ScnetAuthCallback) => void | Promise<void>): () => void
+  route(rawUrl: string): ScnetAuthCallbackRoute
+}
+
+/**
+ * In-memory callback boundary for the Desktop shell. A state is removed before the
+ * handler runs, so a second delivery cannot invoke the handler again.
+ */
+export function createScnetAuthCallbackRouter(): ScnetAuthCallbackRouter {
+  const pending = new Map<string, (callback: ScnetAuthCallback) => void | Promise<void>>()
+  const consumed = new Set<string>()
+
+  return {
+    register(state, handler) {
+      if (state.length === 0 || state.length > MAX_STATE_LENGTH || /[\u0000-\u001f\u007f]/u.test(state)) {
+        throw new ScnetAuthCallbackParseError('missing-state')
+      }
+      if (pending.has(state)) throw new ScnetAuthCallbackParseError('invalid-parameters')
+      pending.set(state, handler)
+      return () => {
+        if (pending.get(state) === handler) pending.delete(state)
+      }
+    },
+    route(rawUrl) {
+      let callback: ScnetAuthCallback
+      try {
+        callback = parseScnetAuthCallbackUrl(rawUrl)
+      } catch (error) {
+        if (error instanceof ScnetAuthCallbackParseError) {
+          if (error.code === 'invalid-target') return { status: 'ignored' }
+          return { status: 'rejected', code: error.code }
+        }
+        return { status: 'rejected', code: 'invalid-url' }
+      }
+      if (consumed.has(callback.state)) return { status: 'replayed' }
+      const handler = pending.get(callback.state)
+      if (handler === undefined) return { status: 'unknown-state' }
+      pending.delete(callback.state)
+      consumed.add(callback.state)
+      void Promise.resolve().then(() => handler(callback)).catch(() => undefined)
+      return { status: 'accepted', callback }
+    },
+  }
+}
