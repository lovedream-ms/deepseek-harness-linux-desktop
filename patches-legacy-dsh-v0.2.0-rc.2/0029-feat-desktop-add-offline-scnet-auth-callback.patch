diff --git a/apps/desktop/tests/scnet-auth-callback.spec.ts b/apps/desktop/tests/scnet-auth-callback.spec.ts
new file mode 100644
index 0000000..158e5fb
--- /dev/null
+++ b/apps/desktop/tests/scnet-auth-callback.spec.ts
@@ -0,0 +1,62 @@
+import { describe, expect, it, vi } from 'vitest'
+import {
+  createScnetAuthCallbackRouter,
+  parseScnetAuthCallbackUrl,
+  ScnetAuthCallbackParseError,
+} from '../src/scnet-auth-callback.ts'
+
+describe('SCNet auth callback deep link', () => {
+  it('parses a success callback without contacting a server', () => {
+    expect(parseScnetAuthCallbackUrl('dsh://auth/scnet?code=opaque-code&state=opaque-state')).toEqual({
+      kind: 'success',
+      code: 'opaque-code',
+      state: 'opaque-state',
+    })
+  })
+
+  it('parses an OAuth error and keeps optional issuer evidence opaque', () => {
+    expect(parseScnetAuthCallbackUrl(
+      'dsh://auth/scnet?error=access_denied&error_description=cancelled&error_uri=https%3A%2F%2Fexample.invalid%2Fhelp&iss=https%3A%2F%2Fissuer.invalid&state=opaque-state',
+    )).toEqual({
+      kind: 'error',
+      error: 'access_denied',
+      description: 'cancelled',
+      errorUri: 'https://example.invalid/help',
+      issuer: 'https://issuer.invalid',
+      state: 'opaque-state',
+    })
+  })
+
+  it.each([
+    'https://auth/scnet?code=opaque&state=opaque-state',
+    'dsh://wrong/scnet?code=opaque&state=opaque-state',
+    'dsh://auth/other?code=opaque&state=opaque-state',
+    'dsh://auth/scnet?code=opaque&state=opaque-state#fragment',
+    'dsh://auth/scnet?code=opaque&state=opaque-state&state=again',
+    'dsh://auth/scnet?code=opaque&state=opaque-state&unexpected=value',
+    'dsh://auth/scnet?code=opaque',
+    'dsh://auth/scnet?code=opaque&error=access_denied&state=opaque-state',
+  ])('rejects an unsupported callback shape: %s', (url) => {
+    expect(() => parseScnetAuthCallbackUrl(url)).toThrow(ScnetAuthCallbackParseError)
+  })
+
+  it('consumes a registered state once before invoking the handler', async () => {
+    const router = createScnetAuthCallbackRouter()
+    const handler = vi.fn()
+    const unregister = router.register('opaque-state', handler)
+    const url = 'dsh://auth/scnet?code=opaque-code&state=opaque-state'
+    expect(router.route(url)).toMatchObject({ status: 'accepted' })
+    expect(router.route(url)).toEqual({ status: 'replayed' })
+    await Promise.resolve()
+    expect(handler).toHaveBeenCalledOnce()
+    unregister()
+  })
+
+  it('does not consume callbacks for an unknown state', () => {
+    const router = createScnetAuthCallbackRouter()
+    const url = 'dsh://auth/scnet?error=access_denied&state=unknown-state'
+    expect(router.route(url)).toEqual({ status: 'unknown-state' })
+    router.register('unknown-state', vi.fn())
+    expect(router.route(url)).toMatchObject({ status: 'accepted' })
+  })
+})
