index 0000000..ebf5451
--- /dev/null
+++ b/apps/desktop/src/scnet-secret-service.ts
@@ -0,0 +1,121 @@
+import { spawn } from 'node:child_process'
+import { statSync } from 'node:fs'
+import { delimiter, join } from 'node:path'
+
+const SECRET_TOOL = 'secret-tool'
+const APPLICATION = 'dsh-scnet'
+const PROFILE = 'default'
+const LABEL = 'SCNet credentials (DeepSeek Harness)'
+
+export type SecretServiceOperation = 'lookup' | 'store' | 'clear'
+
+export interface ScnetSecretStore {
+  readonly provider: 'Secret Service'
+  read(): Promise<string | undefined>
+  write(value: string): Promise<void>
+  clear(): Promise<void>
+}
+
+export interface ScnetSecretServiceDependencies {
+  readonly platform?: NodeJS.Platform
+  readonly environment?: NodeJS.ProcessEnv
+  readonly commandExists?: (command: string) => boolean
+  readonly run?: (operation: SecretServiceOperation, args: readonly string[], input?: string) => Promise<{
+    readonly stdout: string
+    readonly code: number
+  }>
+}
+
+export class ScnetSecretServiceError extends Error {
+  readonly code: 'unsupported-platform' | 'unavailable' | 'command-failed'
+  readonly operation: SecretServiceOperation
+
+  constructor(code: ScnetSecretServiceError['code'], operation: SecretServiceOperation) {
+    super(`Secret Service ${operation} failed (${code})`)
+    this.name = 'ScnetSecretServiceError'
+    this.code = code
+    this.operation = operation
+  }
+}
+
+function pathCommandExists(command: string, environment: NodeJS.ProcessEnv): boolean {
+  const path = environment.PATH ?? ''
+  return path.split(delimiter).some((directory) => {
+    try { return statSync(join(directory, command)).isFile() }
+    catch { return false }
+  })
+}
+
+function defaultCommandExists(command: string, environment: NodeJS.ProcessEnv): boolean {
+  if (command.includes('/') && command.startsWith('/')) return false
+  return pathCommandExists(command, environment)
+}
+
+function defaultRun(
+  operation: SecretServiceOperation,
+  args: readonly string[],
+  input?: string,
+): Promise<{ readonly stdout: string; readonly code: number }> {
+  return new Promise((resolve, reject) => {
+    const child = spawn(SECRET_TOOL, args, {
+      stdio: ['pipe', 'pipe', 'ignore'],
+      windowsHide: true,
+    })
+    let stdout = ''
+    child.stdout.setEncoding('utf8')
+    child.stdout.on('data', (chunk) => { stdout += String(chunk) })
+    child.once('error', (error) => {
+      if ((error as NodeJS.ErrnoException).code === 'ENOENT') {
+        reject(new ScnetSecretServiceError('unavailable', operation))
+      } else {
+        reject(new ScnetSecretServiceError('command-failed', operation))
+      }
+    })
+    child.once('close', (code) => { resolve({ stdout, code: code ?? 1 }) })
+    if (input !== undefined) {
+      child.stdin.end(input)
+    } else {
+      child.stdin.end()
+    }
+  })
+}
+
+function attributes(): string[] {
+  return ['application', APPLICATION, 'profile', PROFILE]
+}
+
+export function createLinuxScnetSecretStore(
+  dependencies: ScnetSecretServiceDependencies = {},
+): ScnetSecretStore | undefined {
+  const platform = dependencies.platform ?? process.platform
+  if (platform !== 'linux') return undefined
+  const environment = dependencies.environment ?? process.env
+  const commandExists = dependencies.commandExists ?? (command => defaultCommandExists(command, environment))
+  if (!commandExists(SECRET_TOOL)) return undefined
+  const run = dependencies.run ?? defaultRun
+  const invoke = async (operation: SecretServiceOperation, args: readonly string[], input?: string): Promise<string> => {
+    try {
+      const result = await run(operation, args, input)
+      if (result.code !== 0) throw new ScnetSecretServiceError('command-failed', operation)
+      return result.stdout
+    } catch (error) {
+      if (error instanceof ScnetSecretServiceError) throw error
+      throw new ScnetSecretServiceError('command-failed', operation)
+    }
+  }
+  return {
+    provider: 'Secret Service',
+    async read(): Promise<string | undefined> {
+      const output = await invoke('lookup', ['lookup', ...attributes()])
+      const value = output.trim()
+      return value === '' ? undefined : value
+    },
+    async write(value: string): Promise<void> {
+      if (value.trim() === '') throw new ScnetSecretServiceError('command-failed', 'store')
+      await invoke('store', ['store', '--label', LABEL, ...attributes()], `${value}\n`)
+    },
+    async clear(): Promise<void> {
+      await invoke('clear', ['clear', ...attributes()])
+    },
+  }
+}
diff --git a/apps/desktop/tests/scnet-secret-service.spec.ts b/apps/desktop/tests/scnet-secret-service.spec.ts
new file mode 100644
index 0000000..f6c6770
--- /dev/null
+++ b/apps/desktop/tests/scnet-secret-service.spec.ts
@@ -0,0 +1,49 @@
+import { describe, expect, it, vi } from 'vitest'
+import {
+  createLinuxScnetSecretStore,
+  ScnetSecretServiceError,
+  type ScnetSecretServiceDependencies,
+} from '../src/scnet-secret-service.ts'
+
+describe('Linux Secret Service adapter', () => {
+  it('does not expose an adapter outside Linux or without secret-tool', () => {
+    expect(createLinuxScnetSecretStore({ platform: 'darwin', commandExists: () => true })).toBeUndefined()
+    expect(createLinuxScnetSecretStore({ platform: 'linux', commandExists: () => false })).toBeUndefined()
+  })
+
+  it('stores opaque values through stdin and reads them back without logging them', async () => {
+    const calls: Array<{ operation: string; args: readonly string[]; input: string | undefined }> = []
+    const run: NonNullable<ScnetSecretServiceDependencies['run']> = async (operation, args, input) => {
+      calls.push({ operation, args, input })
+      return { stdout: operation === 'lookup' ? 'opaque-token-payload\n' : '', code: 0 }
+    }
+    const store = createLinuxScnetSecretStore({ platform: 'linux', commandExists: () => true, run })!
+    await store.write('opaque-token-payload')
+    await expect(store.read()).resolves.toBe('opaque-token-payload')
+    expect(calls[0]).toEqual({
+      operation: 'store',
+      args: ['store', '--label', 'SCNet credentials (DeepSeek Harness)', 'application', 'dsh-scnet', 'profile', 'default'],
+      input: 'opaque-token-payload\n',
+    })
+    expect(calls[1]).toEqual({
+      operation: 'lookup',
+      args: ['lookup', 'application', 'dsh-scnet', 'profile', 'default'],
+    })
+  })
+
+  it('clears only the fixed application/profile item', async () => {
+    const run = vi.fn(async () => ({ stdout: '', code: 0 }))
+    const store = createLinuxScnetSecretStore({ platform: 'linux', commandExists: () => true, run })!
+    await store.clear()
+    expect(run).toHaveBeenCalledWith('clear', ['clear', 'application', 'dsh-scnet', 'profile', 'default'], undefined)
+  })
+
+  it('rejects empty values and does not include secret output in errors', async () => {
+    const run = vi.fn(async () => ({ stdout: 'private-secret-value', code: 1 }))
+    const store = createLinuxScnetSecretStore({ platform: 'linux', commandExists: () => true, run })!
+    await expect(store.write('')).rejects.toMatchObject({ code: 'command-failed', operation: 'store' })
+    await expect(store.read()).rejects.toMatchObject({ code: 'command-failed', operation: 'lookup' })
+    await expect(store.read()).rejects.not.toThrow('private-secret-value')
+    expect(new ScnetSecretServiceError('unavailable', 'lookup').message).not.toContain('private-secret')
+  })
+})
