@@ -0,0 +1,91 @@
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { afterEach, describe, expect, it } from 'vitest'
+import { readScnetDiagnostics } from '../src/scnet-diagnostics.ts'
+
+const roots: string[] = []
+afterEach(() => {
+  for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true })
+})
+
+function profile(bundles: string[], disabled = false): string {
+  const root = mkdtempSync(join(tmpdir(), 'dsh-scnet-diagnostics-'))
+  roots.push(root)
+  writeFileSync(join(root, 'package.json'), JSON.stringify({ dsh: { profile: { bundles } } }))
+  if (disabled) writeFileSync(join(root, '.dsh-scnet.disabled'), '0.6.8\n')
+  return root
+}
+
+const readyPython = async () => ({ state: 'ready' as const, executable: 'python3', version: '3.12.1' })
+
+describe('SCNet Desktop diagnostics', () => {
+  it('reports a ready bundle without exposing credential values', async () => {
+    const configHome = mkdtempSync(join(tmpdir(), 'dsh-scnet-config-'))
+    roots.push(configHome)
+    const result = await readScnetDiagnostics({
+      profilePath: profile(['@deepseek-ai/dsh-web-app', 'dsh-scnet']),
+      environment: {
+        XDG_CONFIG_HOME: configHome,
+        SCNET_OPENAPI_USER: 'private-user',
+        SCNET_OPENAPI_ACCESS_KEY: 'private-access',
+        SCNET_OPENAPI_SECRET_KEY: 'private-secret',
+        PATH: '',
+      },
+      probePython: readyPython,
+      commandExists: () => false,
+    })
+    expect(result).toEqual({
+      overall: 'ready',
+      bundle: { state: 'ready', detail: '0.6.8' },
+      python: { state: 'ready', detail: '3.12.1 (python3)' },
+      credentials: { state: 'ready', detail: 'configured' },
+      backend: { state: 'ready', detail: 'openapi' },
+      authentication: { state: 'needs-setup', detail: 'authorization required' },
+    })
+    expect(JSON.stringify(result)).not.toContain('private-')
+  })
+
+  it('distinguishes disabled profiles and missing local setup', async () => {
+    const configHome = mkdtempSync(join(tmpdir(), 'dsh-scnet-config-'))
+    roots.push(configHome)
+    const result = await readScnetDiagnostics({
+      profilePath: profile(['@deepseek-ai/dsh-web-app', 'dsh-scnet'], true),
+      environment: { XDG_CONFIG_HOME: configHome, PATH: '' },
+      probePython: async () => ({ state: 'unavailable' as const }),
+      commandExists: () => false,
+    })
+    expect(result.overall).toBe('disabled')
+    expect(result.bundle).toEqual({ state: 'disabled', detail: '0.6.8' })
+    expect(result.credentials).toEqual({ state: 'needs-setup', detail: 'not configured' })
+  })
+
+  it('reports unavailable Python separately from an active bundle', async () => {
+    const root = profile(['dsh-scnet'])
+    const result = await readScnetDiagnostics({
+      profilePath: root,
+      environment: { PATH: '' },
+      probePython: async () => ({ state: 'unavailable' as const }),
+      commandExists: () => false,
+    })
+    expect(result.overall).toBe('unavailable')
+    expect(result.bundle.state).toBe('ready')
+    expect(result.python.state).toBe('unavailable')
+  })
+
+  it('reads only backend metadata from the local config', async () => {
+    const configHome = mkdtempSync(join(tmpdir(), 'dsh-scnet-config-'))
+    roots.push(configHome)
+    const root = join(configHome, 'scnet-hpc')
+    mkdirSync(root)
+    writeFileSync(join(root, 'config.json'), JSON.stringify({ DEFAULT_BACKEND: 'ssh' }))
+    const result = await readScnetDiagnostics({
+      profilePath: profile(['dsh-scnet']),
+      environment: { XDG_CONFIG_HOME: configHome, PATH: '' },
+      probePython: readyPython,
+      commandExists: () => false,
+    })
+    expect(result.backend).toEqual({ state: 'ready', detail: 'ssh' })
+    expect(result.authentication).toEqual({ state: 'needs-setup', detail: 'not configured' })
+  })
+})
